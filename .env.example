# Environment Variables — RamalTani Backend
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Server ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://ramaltani_user:rizal2302.@postgre.rizalzaky.cloud:5432/ramaltani_db
DB_HOST=postgre.rizalzaky.cloud
DB_PORT=5432
DB_NAME=ramaltani_db
DB_USER=ramaltani_user
DB_PASSWORD=rizal2302.
USE_CLOUDFLARE_TUNNEL=true
CLOUDFLARE_TUNNEL_PORT=5433

# ─── Kinde Authentication (Google / Social Auth) ──────────
KINDE_CLIENT_ID=a00410884d8e4a6db60f78c7784477d3
KINDE_ISSUER_BASE_URL=https://rizalzaky.kinde.com
KINDE_SITE_URL=http://localhost:5001/kinde-success
KINDE_SECRET=your_kinde_secret_here
KINDE_REDIRECT_URL=http://localhost:3000/callback

# ─── BMKG Weather API ─────────────────────────────────────
BMKG_BASE_URL=https://api.bmkg.go.id
BMKG_CACHE_TTL_MINUTES=30

# ─── Open-Meteo ───────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_CACHE_TTL_MINUTES=30

# ─── Notification Providers ───────────────────────────────
# Twilio (SMS/WhatsApp) — Leave empty to use MockNotificationProvider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ramaltani.id

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
